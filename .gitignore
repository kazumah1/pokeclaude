.cache/
__pycache__/
*.pyc
spike/*.log

# tools/preview_card.py output
card-*.png

# Local install artifacts. `install.py --host kiro --workspace .` copies the
# skills in and backs up whatever hook config it replaces; both are specific to
# one machine and belong to whoever installed, not to the repo.
*.pokeclaude-backup
.kiro/skills/
# Generated by `install.py --host kiro --workspace .`, and it contains an
# absolute path to wherever this clone lives. Tracking it meant every install
# rewrote a committed file with one machine's paths.
.kiro/hooks/pokeclaude.json

# Publishing scaffolding — not part of the project
PUBLISH.md
